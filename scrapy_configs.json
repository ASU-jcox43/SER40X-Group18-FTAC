      "ottawa.ca"
    ],
    "layers": 1,
    "get_pdfs": false,
    "layer_filter": {
      "regex": "laws-z"
    },
    "name_filter": {
      "xpath": "//*[@class=\"page-title\"]/text()",
      "regex": "(.*)\\("
    },
    "number_filter": {
      "xpath": "//*[@class=\"page-title\"]/text()",
      "regex": "By-law No. \\d+-(\\d+)"
    },
    "year_filter": {
      "xpath": "//*[@class=\"page-title\"]/text()",
      "regex": "By-law No. (\\d+)-\\d+"
    }
